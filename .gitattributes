* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Git LFS: production 3D models and audio must never enter normal Git history.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.m4a filter=lfs diff=lfs merge=lfs -text

# High-resolution production character and texture art uses LFS.
public/assets/characters/**/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/characters/**/*.webp filter=lfs diff=lfs merge=lfs -text
public/assets/track/**/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/track/**/*.webp filter=lfs diff=lfs merge=lfs -text
public/assets/karts/**/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/karts/**/*.webp filter=lfs diff=lfs merge=lfs -text

# PRD-sized runtime avatar derivatives stay in normal Git for direct delivery.
public/assets/characters/**/portrait.png -filter -diff -merge -text
public/assets/characters/**/driver/*.png -filter -diff -merge -text

# Character Select full-body illustrations are fixed-size runtime avatar derivatives.
# Generated/source masters remain outside this delivery path and remain governed by LFS.
public/assets/characters/**/selection/full-body.png -filter -diff -merge -text

# Results/Podium character illustrations are fixed-size runtime derivatives.
# Generated/source masters remain outside this delivery path and remain governed by LFS.
public/assets/characters/**/results/*.png -filter -diff -merge -text

# The approved fixed-size Results environment is an opaque runtime derivative.
public/assets/ui/route-night/results-podium-backdrop.webp -filter -diff -merge -text
